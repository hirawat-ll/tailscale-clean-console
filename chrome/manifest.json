{
  "manifest_version": 3,
  "name": "Tailscale Clean Console",
  "version": "1.0.0",
  "description": "Hides the trial/billing banner and shows the Tailscale admin Machines page as a clean card grid.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.tailscale.com/admin/*",
        "https://login.tailscale.com/admin/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
